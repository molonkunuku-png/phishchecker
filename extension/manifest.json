{
  "name": "PhishChecker Browser Extension",
  "description": "Check URLs for phishing without leaving the page", 
  "version": "2.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab", 
    "tabs",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background/worker.js"
  },
  "content_scripts": [{
    "js": ["src/content.js"], 
    "matches": ["*://*/*"]
  }],
  "web_accessible_resources": [{
    "resources": ["popup/*", "icons/*"],
    "matches": ["*://*/*"]
  }],
  "browser_action": {
    "default_popup": "popup/form.html",
    "default_icon": {
      "128": "icons/icon128.png",
      "48": "icons/icon48.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": ["_execute_action"],
  "icons": {
    "128": "icons/icon128.png",
    "48": "icons/icon48.png",
    "32": "icons/icon32.png"
  }
}